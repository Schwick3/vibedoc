{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibedoc.dev/schemas/vibedoc-report-v1.json",
  "title": "Vibedoc JSON output version 1",
  "oneOf": [
    { "$ref": "#/$defs/checkReport" },
    { "$ref": "#/$defs/operationalError" }
  ],
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/position" },
        "end": { "$ref": "#/$defs/position" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "range"],
      "properties": {
        "path": { "type": "string" },
        "range": { "$ref": "#/$defs/range" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "vibedoc" },
        "version": { "type": "string" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "severity", "message", "document"],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^VDOC-[A-Z][0-9]{3}$" },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string" },
        "document": { "$ref": "#/$defs/location" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/location" }
        },
        "suggestion": { "type": "string" },
        "experimental": { "type": "boolean" }
      }
    },
    "checkReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "tool", "status", "diagnostics", "verification", "summary"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "tool": { "$ref": "#/$defs/tool" },
        "status": { "enum": ["pass", "fail"] },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verifiedStructuralClaims", "contradictedStructuralClaims", "unverifiedStructuralClaims", "freeFormProseEvaluated"],
          "properties": {
            "verifiedStructuralClaims": { "type": "integer", "minimum": 0 },
            "contradictedStructuralClaims": { "type": "integer", "minimum": 0 },
            "unverifiedStructuralClaims": { "type": "integer", "minimum": 0 },
            "freeFormProseEvaluated": { "type": "boolean" }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["errors", "warnings", "info", "documents"],
          "properties": {
            "errors": { "type": "integer", "minimum": 0 },
            "warnings": { "type": "integer", "minimum": 0 },
            "info": { "type": "integer", "minimum": 0 },
            "documents": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "operationalError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "tool", "status", "error"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "tool": { "$ref": "#/$defs/tool" },
        "status": { "const": "error" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["message"],
          "properties": {
            "message": { "type": "string" }
          }
        }
      }
    }
  }
}
