{
  "name": "vibedoc-workspace",
  "private": true,
  "workspaces": [
    "adapters/*"
  ],
  "scripts": {
    "build": "npm run build --workspace vibedoc-adapter-typescript",
    "test": "npm run test:adapter && npm run test:release",
    "test:adapter": "npm run test --workspace vibedoc-adapter-typescript",
    "test:release": "node --test scripts/*.test.mjs",
    "test:e2e": "./scripts/test-e2e.sh",
    "test:evaluation": "./scripts/test-evaluation.sh",
    "test:real-project": "node scripts/test-real-project.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  },
  "engines": {
    "node": ">=22"
  }
}
